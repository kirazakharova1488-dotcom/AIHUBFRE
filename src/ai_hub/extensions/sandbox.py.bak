"""Sandbox: isolated execution of generated extension code with resource limits."""

from __future__ import annotations

import contextlib
import os
import signal
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

try:
    import resource  # Unix only
    _HAS_RESOURCE = True
except ImportError:  # pragma: no cover - Windows lacks resource
    _HAS_RESOURCE = False

from ai_hub.config import settings


@dataclass
class SandboxResult:
    stdout: str = ""
    stderr: str = ""
    exit_code: int = 0
    timed_out: bool = False
    memory_exceeded: bool = False
    duration_ms: int = 0


def _set_limits() -> None:
    if not _HAS_RESOURCE:
        return
    try:
        max_mem = settings.sandbox_max_memory_mb * 1024 * 1024
        resource.setrlimit(resource.RLIMIT_AS, (max_mem, max_mem))
    except (ValueError, OSError):
        pass
    try:
        resource.setrlimit(resource.RLIMIT_CPU, (settings.sandbox_timeout, settings.sandbox_timeout + 1))
    except (ValueError, OSError):
        pass


def _set_network_restriction() -> None:
    """Best-effort network restriction; falls back to a sandbox flag."""
    if not _HAS_RESOURCE:
        return
    if not settings.network_access_allowed:
        try:
            resource.setrlimit(resource.RLIMIT_NOFILE, (0, 0))
        except (ValueError, OSError):
            pass


def run_in_sandbox(
    code: str,
    *,
    timeout: int | None = None,
    max_memory_mb: int | None = None,
    network: bool = False,
    env: dict[str, str] | None = None,
) -> SandboxResult:
    """Execute a Python snippet in a subprocess with CPU/memory/time limits."""
    timeout = timeout or settings.sandbox_timeout
    max_memory_mb = max_memory_mb or settings.sandbox_max_memory_mb

    runner = (
        "import sys, json, traceback\n"
        "try:\n"
        "    import resource\n"
        "except ImportError:\n"
        "    resource = None\n"
        "def _limit():\n"
        f"    if resource is not None:\n"
        f"        try: resource.setrlimit(resource.RLIMIT_AS, ({max_memory_mb}*1024*1024, {max_memory_mb}*1024*1024))\n"
        f"        except Exception: pass\n"
        f"        try: resource.setrlimit(resource.RLIMIT_CPU, ({timeout}, {timeout}+1))\n"
        f"        except Exception: pass\n"
        "    if not %r:\n"
        "        if resource is not None:\n"
        "            try: resource.setrlimit(resource.RLIMIT_NOFILE, (0, 0))\n"
        "            except Exception: pass\n"
        "_limit()\n"
        "try:\n"
        "    exec(compile(%r, '<extension>', 'exec'))\n"
        "except SystemExit as e:\n"
        "    print(json.dumps({'exit': e.code}))\n"
        "except Exception:\n"
        "    traceback.print_exc()\n"
        % (network, code)
    )

    start = time.time()
    try:
        proc = subprocess.run(
            [sys.executable, "-c", runner],
            capture_output=True,
            text=True,
            timeout=timeout,
            env={**os.environ, **(env or {})},
        )
        return SandboxResult(
            stdout=proc.stdout,
            stderr=proc.stderr,
            exit_code=proc.returncode,
            duration_ms=int((time.time() - start) * 1000),
        )
    except subprocess.TimeoutExpired as exc:
        return SandboxResult(
            stdout=exc.stdout.decode() if isinstance(exc.stdout, bytes) else (exc.stdout or ""),
            stderr=exc.stderr.decode() if isinstance(exc.stderr, bytes) else (exc.stderr or ""),
            exit_code=-1,
            timed_out=True,
            duration_ms=int((time.time() - start) * 1000),
        )


def run_tests(extension_dir: Path, timeout: int = 60) -> SandboxResult:
    """Run pytest in the extension directory, isolated."""
    start = time.time()
    try:
        proc = subprocess.run(
            [sys.executable, "-m", "pytest", "-q", "--no-header", str(extension_dir)],
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return SandboxResult(
            stdout=proc.stdout, stderr=proc.stderr, exit_code=proc.returncode,
            duration_ms=int((time.time() - start) * 1000),
        )
    except subprocess.TimeoutExpired as exc:
        return SandboxResult(
            stdout=exc.stdout.decode() if isinstance(exc.stdout, bytes) else (exc.stdout or ""),
            stderr=exc.stderr.decode() if isinstance(exc.stderr, bytes) else (exc.stderr or ""),
            exit_code=-1, timed_out=True,
            duration_ms=int((time.time() - start) * 1000),
        )