# AI HUB CLI configuration example. Copy to `.env` and adjust.
# Secrets are never committed — never hardcode keys in source.

# General
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=60

# OpenAI-compatible providers (any one enables use of `aihub models list`)
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Tokens / limits
DEFAULT_OUTPUT_TOKEN_LIMIT=2000
DEFAULT_CONTEXT_TOKEN_LIMIT=8000
SANDBOX_ENABLED=true
NETWORK_ACCESS_ALLOWED=false
